# ============================================================
# AGENTIC STRATEGIC INTELLIGENCE SYSTEM — Configuration
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# OpenAI-compatible endpoint. Set to http://localhost:11434/v1 for Ollama.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
# Temperature for reasoning agents (0.3 = focused but not robotic)
LLM_TEMPERATURE=0.3

# ── Embedding Provider ───────────────────────────────────────
# Local sentence-transformers model (no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Or use OpenAI embeddings: text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Web Search Provider ──────────────────────────────────────
# Tavily (recommended, free tier available): https://tavily.com
TAVILY_API_KEY=
# SerpAPI fallback
SERPAPI_KEY=
# Set DEMO_MODE=true to skip all external search and use fixtures
DEMO_MODE=false

# ── News Provider (optional) ─────────────────────────────────
NEWSAPI_KEY=

# ── Vector Database ──────────────────────────────────────────
# ChromaDB local path (default: ./data/chroma)
CHROMA_PERSIST_DIR=./data/chroma
# Future: Pinecone, Weaviate, Qdrant
# PINECONE_API_KEY=
# WEAVIATE_URL=

# ── Relational Database ──────────────────────────────────────
# SQLite by default (no setup needed). Switch to Postgres for production.
DATABASE_URL=sqlite:///./data/twin.db
# POSTGRES_URL=postgresql://user:pass@localhost:5432/twin

# ── Application Settings ─────────────────────────────────────
PORT=8000
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
# Maximum agent iterations per case (prevents runaway loops)
MAX_ITERATIONS=12
# Maximum research calls per case
MAX_RESEARCH_CALLS=6
# Maximum LLM calls per run
MAX_LLM_CALLS=40
# Case timeout in seconds
CASE_TIMEOUT_SECONDS=300

# ── Optional Future Integrations ─────────────────────────────
# Redis (for durable queuing in production)
# REDIS_URL=redis://localhost:6379

# n8n (for workflow automation)
# N8N_WEBHOOK_URL=

# MCP (Model Context Protocol tools)
# MCP_SERVER_URL=

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=digital-twin-mvp

# ── Authentication (future) ──────────────────────────────────
# AUTH_SECRET_KEY=
# AUTH_ALGORITHM=HS256
