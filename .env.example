# ============================================================
# AGENTIC STRATEGIC INTELLIGENCE SYSTEM — Configuration
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# OpenAI-compatible endpoint. Gemini's compatible endpoint is shown here;
# set the URL, key and model for another supported provider as needed.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash
# Temperature for reasoning agents (0.3 = focused but not robotic)
LLM_TEMPERATURE=0.3
# Per-attempt timeout and retry count. Keep their combined budget below
# CASE_TIMEOUT_SECONDS so a slow provider cannot consume the whole workflow.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# Sent to Gemini's OpenAI-compatible API; ignored for other providers.
LLM_REASONING_EFFORT=low

# ── Embedding Provider ───────────────────────────────────────
# Local sentence-transformers model (no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Or use OpenAI embeddings: text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Web Search Provider ──────────────────────────────────────
# Tavily (recommended, free tier available): https://tavily.com
TAVILY_API_KEY=
# SerpAPI fallback
SERPAPI_KEY=
# Set DEMO_MODE=true to skip all external search and use fixtures
DEMO_MODE=false

# ── News Provider (optional) ─────────────────────────────────
NEWSAPI_KEY=

# ── Vector Database ──────────────────────────────────────────
# ChromaDB local path (default: ./data/chroma)
CHROMA_PERSIST_DIR=./data/chroma
# Future: Pinecone, Weaviate, Qdrant
# PINECONE_API_KEY=
# WEAVIATE_URL=

# ── Relational Database ──────────────────────────────────────
# SQLite by default (no setup needed). Switch to Postgres for production.
DATABASE_URL=sqlite:///./data/twin.db
# POSTGRES_URL=postgresql://user:pass@localhost:5432/twin

# ── Application Settings ─────────────────────────────────────
PORT=8000
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
# Maximum agent iterations per case (prevents runaway loops)
MAX_ITERATIONS=12
# Maximum research calls per case
MAX_RESEARCH_CALLS=6
# Maximum LLM calls per run
MAX_LLM_CALLS=40
# Case timeout in seconds
CASE_TIMEOUT_SECONDS=1200

# ── Optional Future Integrations ─────────────────────────────
# Redis (for durable queuing in production)
# REDIS_URL=redis://localhost:6379

# n8n (for workflow automation)
# N8N_WEBHOOK_URL=

# MCP (Model Context Protocol tools)
# MCP_SERVER_URL=

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=digital-twin-mvp

# ── Private workspace ────────────────────────────────────────
# One invite-only account is created on startup when both values are set.
# Additional accounts may be created through the server-side user store.
STRATEGY_DEMO_EMAIL=founder@example.com
STRATEGY_DEMO_PASSWORD=replace-with-a-long-unique-password
STRATEGY_DB_PATH=./data/workspace.sqlite3
# Set true behind HTTPS in deployment.
STRATEGY_COOKIE_SECURE=false
# Comma-separated origins for a separate Vite dev server.
STRATEGY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Canonical PostgreSQL (local dev via docker compose; managed secrets in deployment) ---
# Owner role runs migrations only; twin_app (non-owner, RLS-bound) is used by the application.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_PORT=5433
POSTGRES_DB=twin
POSTGRES_HOST=127.0.0.1
